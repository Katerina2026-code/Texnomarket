Процедура ПередЗаписью(Отказ)
	Наименование = СокрЛП(Наименование); 
	Артикул = СокрЛП(Артикул); 
	Если ПустаяСтрока(Наименование) Тогда 
		Сообщить("Ошибка: Нельзя записать товар без наименования!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если Не ПустаяСтрока(Артикул) Тогда 
		СсылкаНаДубль = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Артикул);
		Если ЗначениеЗаполнено(СсылкаНаДубль) И (СсылкаНаДубль <> Ссылка) Тогда
			Сообщить("Ошибка! Артикул " + Артикул + " уже занят товаром: " + СсылкаНаДубль); 
			Отказ = Истина;
	КонецЕсли;
КонецЕсли;
КонецПроцедуры 