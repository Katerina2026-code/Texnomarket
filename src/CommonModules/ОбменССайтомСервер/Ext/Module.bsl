Процедура ВыполнитьРегламентныйОбмен() Экспорт
	НастройкиОбмена = ПолучитьНастройкиИнтеграции();
	ВыгрузитьИзмененияНаСайт(НастройкиОбмена);
	ЗагрузитьЗаказыССайта(НастройкиОбмена);
	
КонецПроцедуры

Функция ПолучитьНастройкиИнтеграции()
	Настройки = Новый Структура("АдресСайта, Логин, Пароль", "", "", "");
	
	Выборка = РегистрыСведений.НастройкиИнтеграции.Выбрать();
	Если Выборка.Следующий() Тогда
		Настройки.АдресСайта = Выборка.АдресСайта;
		Настройки.Логин = Выборка.Логин;
		Если Выборка.ПарольУстановлен Тогда
			Настройки.Пароль = ХранилищеОбщихНастроек.Загрузить("ИнтеграцияССайтом", "Пароль");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Настройки;
КонецФункции

Процедура ВыгрузитьИзмененияНаСайт(НастройкиОбмена)
	ИдентификаторСеанса = Строка(Новый УникальныйИдентификатор());
	Попытка
		ПодключениеКаталог = ПодключитьсяКБитрикс(НастройкиОбмена, "catalog");
		ТекстXMLКаталога = СформироватьXMLКаталога();
		ОтправитьФайлВБитрикс(
			ПодключениеКаталог.Соединение,
			ПодключениеКаталог.Заголовки,
			"catalog",
			"import.xml",
			ТекстXMLКаталога,
			Истина);
		ТекстXMLПредложений = СформироватьXMLПредложений();
		ОтправитьФайлВБитрикс(
			ПодключениеКаталог.Соединение,
			ПодключениеКаталог.Заголовки,
			"catalog",
			"offers.xml",
			ТекстXMLПредложений,
			Истина);
		ПодключениеЗаказы = ПодключитьсяКБитрикс(НастройкиОбмена, "sale");
		ТекстXMLСтатусов = СформироватьXMLСтатусовЗаказов();
		ОтправитьФайлВБитрикс(
			ПодключениеЗаказы.Соединение,
			ПодключениеЗаказы.Заголовки,
			"sale",
			"orders.xml",
			ТекстXMLСтатусов,
			Истина);
		ЗаписатьЛогОбмена(ИдентификаторСеанса, "ВыгрузкаНаСайт", 3, 0, "");
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьЛогОбмена(ИдентификаторСеанса, "ВыгрузкаНаСайт", 0, 1, ТекстОшибки);
		ВызватьИсключение;
	КонецПопытки;	
КонецПроцедуры

Процедура ЗагрузитьЗаказыССайта(НастройкиОбмена) Экспорт
	
	ИдентификаторСеанса = Строка(Новый УникальныйИдентификатор()); 
	Сервер = СтрРазделить(СтрЗаменить(СтрЗаменить(СокрЛП(НастройкиОбмена.АдресСайта), "https://", ""),"http://", ""), "/")[0];
	ЧастиАдреса = СтрРазделить(Сервер,":");
	Сервер = ЧастиАдреса[0];
	Порт = ?(ЧастиАдреса.Количество() > 1, Число(ЧастиАдреса[1]), ?(Найти(НРег(НастройкиОбмена.АдресСайта),"https://") = 1, 443,80));
		ЗаголовкиЗапроса = Новый Соответствие;
	Попытка
		ЗащищенноеСоединение = ?(Найти(НРег(НастройкиОбмена.АдресСайта), "https://") = 1, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено);
		HTTPСоединение = Новый HTTPСоединение(Сервер, Порт, НастройкиОбмена.Логин, НастройкиОбмена.Пароль, , , ЗащищенноеСоединение);
		// 1. Авторизация по протоколу CommerceML (checkauth)
		ЗапросАвторизации = Новый HTTPЗапрос("/bitrix/admin/1c_exchange.php?type=sale&mode=checkauth");
		ОтветАвторизации = HTTPСоединение.Получить(ЗапросАвторизации);
		Если ОтветАвторизации.КодСостояния <> 200 Тогда
			ВызватьИсключение("Ошибка авторизации.КодСостояния:" + ОтветАвторизации.КодСостояния);
		КонецЕсли;
		// Ответ приходит в 3 строки: [0] = success, [1] = имя cookie, [2] = значение Сookie
		СтрокиАвторизации = СтрРазделить(ОтветАвторизации.ПолучитьТелоКакСтроку(), Символы.ПС, Ложь);
		Если СтрокиАвторизации.Количество() < 3 Или СокрЛП(СтрокиАвторизации[0]) <> "success" Тогда
			ВызватьИсключение("Сайт отклонил авторизацию: " + ОтветАвторизации.ПолучитьТелоКакСтроку());
		КонецЕсли;
		// Сохраняем Cookie для дальнейших запросов в этом сеансе
		ЗаголовкиЗапроса.Вставить("cookie", СокрЛП(СтрокиАвторизации[1]) + "=" + СокрЛП(СтрокиАвторизации[2]));
		// 2. Запрос заказов (query) с передачей Cookie
		ЗапросHTTP = Новый HTTPЗапрос("/bitrix/admin/1c_exchange.php?type=sale&mode=query", ЗаголовкиЗапроса);
		ОтветHTTP = HTTPСоединение.Получить(ЗапросHTTP);
	Исключение
		ТекстОшибки = "Сайт вернул ошибку соединения: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("Обмен с сайтом. Ошибка", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		ЗаписатьЛогОбмена(ИдентификаторСеанса, "Загрузка с сайта",0,1, ТекстОшибки);
		Возврат;
	КонецПопытки;
	Если ОтветHTTP.КодСостояния <> 200 Тогда
		ТекстОшибки = "Сайт вернул ошибку соединения. Код состояния: " + ОтветHTTP.КодСостояния;
		ЗаписьЖурналаРегистрации("Обмен с сайтом. Ошибка", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		ЗаписатьЛогОбмена(ИдентификаторСеанса, "Загрузка с сайта", 0, 1, ТекстОшибки);
		Возврат;
	КонецЕсли;  
	
	
	ТекстXML = ОтветHTTP.ПолучитьТелоКакСтроку();
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстXML);
	
	ТаблицаЗаказов = Новый ТаблицаЗначений;
	ТаблицаЗаказов.Колонки.Добавить("ИдСайта", Новый ОписаниеТипов("Строка"));
	ТаблицаЗаказов.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	ТаблицаЗаказов.Колонки.Добавить("КонтрагентИмя", Новый ОписаниеТипов("Строка"));
	ТаблицаЗаказов.Колонки.Добавить("КонтрагентТелефон", Новый ОписаниеТипов("Строка"));
	ТаблицаЗаказов.Колонки.Добавить("КонтрагентEmail", Новый ОписаниеТипов("Строка"));
	ТаблицаЗаказов.Колонки.Добавить("КонтрагентИНН", Новый ОписаниеТипов("Строка"));
	ТаблицаЗаказов.Колонки.Добавить("Товары", Новый ОписаниеТипов("ТаблицаЗначений")); 	
	
	ТекущийЗаказ = Неопределено;
	ТекущийТовар = Неопределено;
	ВКонтрагенте = Ложь;
	ВТоварах = Ложь;
	ВТоваре = Ложь;
	ВРеквизитах = Ложь;
	ТекущийТипКонтакта = "";
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ИмяТега = ЧтениеXML.Имя;
			
			Если ИмяТега = "Документ" Тогда
				ТекущийЗаказ = ТаблицаЗаказов.Добавить();
				ТекущийЗаказ.Товары = Новый ТаблицаЗначений;
				ТекущийЗаказ.Товары.Колонки.Добавить("Ид", Новый ОписаниеТипов("Строка"));
				ТекущийЗаказ.Товары.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
				ТекущийЗаказ.Товары.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
				ТекущийЗаказ.Товары.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
				
			ИначеЕсли ТекущийЗаказ <> Неопределено Тогда
				Если ИмяТега = "Контрагент" Тогда
					ВКонтрагенте = Истина;
				ИначеЕсли ИмяТега = "Товары" Тогда
					ВТоварах = Истина;
				ИначеЕсли ИмяТега = "Товар" И ВТоварах Тогда
					ВТоваре = Истина;
					ТекущийТовар = ТекущийЗаказ.Товары.Добавить();
				ИначеЕсли ИмяТега = "ЗначенияРеквизитов" Или ИмяТега = "ЗначениеРеквизита" Тогда
					ВРеквизитах = Истина;
					
					// 1. Поля самого Документа (верхний уровень)
				ИначеЕсли Не ВКонтрагенте И Не ВТоварах И Не ВРеквизитах Тогда
					Если ИмяТега = "Ид" Тогда
						ЧтениеXML.Прочитать();
						ТекущийЗаказ.ИдСайта = СокрЛП(ЧтениеXML.Значение);
					ИначеЕсли ИмяТега = "Номер" Тогда
						ЧтениеXML.Прочитать();
						ТекущийЗаказ.Номер = СокрЛП(ЧтениеXML.Значение);
					КонецЕсли;
					
					// 2. Поля Контрагента (имя, ИНН, телефон, email)
				ИначеЕсли ВКонтрагенте Тогда
					Если ИмяТега = "Наименование" И Не ВРеквизитах Тогда
						ЧтениеXML.Прочитать();
						ТекущийЗаказ.КонтрагентИмя = СокрЛП(ЧтениеXML.Значение);
					ИначеЕсли ИмяТега = "ИНН" Тогда
						ЧтениеXML.Прочитать();
						ТекущийЗаказ.КонтрагентИНН = СокрЛП(ЧтениеXML.Значение);
					ИначеЕсли ИмяТега = "Тип" Тогда
						ЧтениеXML.Прочитать();
						ТекущийТипКонтакта = НРег(СокрЛП(ЧтениеXML.Значение));
					ИначеЕсли ИмяТега = "Значение" Тогда
						ЧтениеXML.Прочитать();
						Если СтрНайти(ТекущийТипКонтакта, "телефон") > 0 Тогда
							ТекущийЗаказ.КонтрагентТелефон = СокрЛП(ЧтениеXML.Значение);
						ИначеЕсли СтрНайти(ТекущийТипКонтакта, "почта") > 0 Или СтрНайти(ТекущийТипКонтакта, "mail") > 0 Тогда
							ТекущийЗаказ.КонтрагентEmail = СокрЛП(ЧтениеXML.Значение);
						КонецЕсли;
						ТекущийТипКонтакта = "";
					КонецЕсли;
					
					// 3. Поля Товара (строго игнорируем вложенные ЗначенияРеквизитов)
				ИначеЕсли ВТоваре И Не ВРеквизитах Тогда
					Если ИмяТега = "Ид" Тогда
						ЧтениеXML.Прочитать();
						ТекущийТовар.Ид = СокрЛП(ЧтениеXML.Значение);
					ИначеЕсли ИмяТега = "Наименование" Тогда
						ЧтениеXML.Прочитать();
						ТекущийТовар.Наименование = СокрЛП(ЧтениеXML.Значение);
					ИначеЕсли ИмяТега = "Количество" Тогда
						ЧтениеXML.Прочитать();
						ТекущийТовар.Количество = Число(СтрЗаменить(ЧтениеXML.Значение, "," , "."));
					ИначеЕсли ИмяТега = "ЦенаЗаЕдиницу" Тогда
						ЧтениеXML.Прочитать();
						ТекущийТовар.Цена = Число(СтрЗаменить(ЧтениеXML.Значение, "," , "."));
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			ИмяТега = ЧтениеXML.Имя;
			Если ИмяТега = "Контрагент" Тогда
				ВКонтрагенте = Ложь;
			ИначеЕсли ИмяТега = "ЗначенияРеквизитов" Или ИмяТега = "ЗначениеРеквизита" Тогда
				ВРеквизитах = Ложь;
			ИначеЕсли ИмяТега = "Товар" Тогда
				ВТоваре = Ложь;
				ТекущийТовар = Неопределено;
			ИначеЕсли ИмяТега = "Товары" Тогда
				ВТоварах = Ложь;
			ИначеЕсли ИмяТега = "Документ" Тогда
				ТекущийЗаказ = Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ЧтениеXML.Закрыть(); 
	
	СкладОбмена = ПолучитьСкладПоУмолчанию();
	КоличествоУспешныхДокументов = 0;
	КоличествоОшибокВОбмене = 0;	
	НакопленныйТекстОшибок = "";
	ПоследнийСозданныйЗаказ = Документы.ЗаказКлиента.ПустаяСсылка();
	
	Для Каждого СтрокаЗаказа Из ТаблицаЗаказов Цикл
		Попытка
			СсылкаЗаказа = ЗагрузитьОдинЗаказ(СтрокаЗаказа, СкладОбмена);
			ПоследнийСозданныйЗаказ = СсылкаЗаказа;
			КоличествоУспешныхДокументов = КоличествоУспешныхДокументов + 1;
		Исключение
			КоличествоОшибокВОбмене = КоличествоОшибокВОбмене + 1;
			ОписаниеОшибкиСтрокой = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			НакопленныйТекстОшибок = НакопленныйТекстОшибок + ОписаниеОшибкиСтрокой + Символы.ПС;
			ЗаписьЖурналаРегистрации("Обмен с сайтом. Ошибка создания документа", УровеньЖурналаРегистрации.Ошибка, , , 
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
	Если КоличествоОшибокВОбмене = 0 И ТаблицаЗаказов.Количество() > 0 Тогда
		Попытка
			ЗапросУспех = Новый HTTPЗапрос("/bitrix/admin/1c_exchange.php?type=sale&mode=success", ЗаголовкиЗапроса);
			HTTPСоединение.Получить(ЗапросУспех);
		Исключение
			ЗаписьЖурналаРегистрации("Обмен с сайтом. Предупреждение", УровеньЖурналаРегистрации.Предупреждение, , , 
			"Не удалось отправить подтверждение mode=success");
		КонецПопытки;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("Обмен с сайтом. Итоги", УровеньЖурналаРегистрации.Информация, , , 
	"Обмен завершен. Создано/обновлено заказов: " + КоличествоУспешныхДокументов + ". Ошибок: " + КоличествоОшибокВОбмене);
	
	ЗаписатьЛогОбмена(
	ИдентификаторСеанса,
	"Загрузка с сайта",
	КоличествоУспешныхДокументов,
	КоличествоОшибокВОбмене,
	СокрЛП(НакопленныйТекстОшибок),
	ПоследнийСозданныйЗаказ
	);
	
КонецПроцедуры  
Функция ПолучитьСкладПоУмолчанию()
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Склады ГДЕ НЕ ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Склады.ПустаяСсылка();
	
КонецФункции 
Функция ЗагрузитьОдинЗаказ(СтрокаЗаказа, СкладОбмена)
	
	// Пункт 7: Защита от дублей при повторной загрузке
	НомерПоиска = ?(ЗначениеЗаполнено(СтрокаЗаказа.Номер), СтрокаЗаказа.Номер, СтрокаЗаказа.ИдСайта);
	НайденныйЗаказ = Документы.ЗаказКлиента.НайтиПоНомеру(НомерПоиска, ТекущаяДатаСеанса());
	
	Если ЗначениеЗаполнено(НайденныйЗаказ) Тогда
		НовыйЗаказ = НайденныйЗаказ.ПолучитьОбъект();
		НовыйЗаказ.Товары.Очистить();
	Иначе
		НовыйЗаказ = Документы.ЗаказКлиента.СоздатьДокумент();
		НовыйЗаказ.Дата = ТекущаяДатаСеанса();
		НовыйЗаказ.Номер = НомерПоиска;
		НовыйЗаказ.СтатусЗаказа = Перечисления.СтатусыЗаказов.Новый;
	КонецЕсли;
	
	НовыйЗаказ.Склад = СкладОбмена;
	
	// Пункт 7: Поиск или создание контрагента без дублей
	Если ЗначениеЗаполнено(СтрокаЗаказа.КонтрагентИмя) 
		Или ЗначениеЗаполнено(СтрокаЗаказа.КонтрагентТелефон) 
		Или ЗначениеЗаполнено(СтрокаЗаказа.КонтрагентEmail) Тогда
		
		НовыйЗаказ.Контрагент = НайтиИлиСоздатьКонтрагента(
		СтрокаЗаказа.КонтрагентИмя,
		СтрокаЗаказа.КонтрагентТелефон,
		СтрокаЗаказа.КонтрагентEmail,
		СтрокаЗаказа.КонтрагентИНН
		);
	КонецЕсли;
	
	// Пункт 6: Поиск товара строго по UUID из <Ид>
	Для Каждого ТоварИзПамяти Из СтрокаЗаказа.Товары Цикл
		НайденнаяНоменклатура = НайтиНоменклатуруПоУИД(ТоварИзПамяти.Ид);
		Если НайденнаяНоменклатура.Пустая() Тогда
			ВызватьИсключение(СтрШаблон("Товар не найден по UUID (%1): %2", 
			ТоварИзПамяти.Ид, ТоварИзПамяти.Наименование));
		КонецЕсли;
		
		НоваяСтрокаТЧ = НовыйЗаказ.Товары.Добавить();
		НоваяСтрокаТЧ.Номенклатура = НайденнаяНоменклатура;
		НоваяСтрокаТЧ.Количество = ТоварИзПамяти.Количество;
		НоваяСтрокаТЧ.Цена = ТоварИзПамяти.Цена;
		НоваяСтрокаТЧ.Сумма = ТоварИзПамяти.Количество * ТоварИзПамяти.Цена;
	КонецЦикла;
	
	НовыйЗаказ.Записать(РежимЗаписиДокумента.Запись);
	Возврат НовыйЗаказ.Ссылка;
	
КонецФункции
Функция НайтиНоменклатуруПоУИД(СтрокаУИД)
	
	Если Не ЗначениеЗаполнено(СтрокаУИД) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Попытка
		УИД = Новый УникальныйИдентификатор(СтрокаУИД);
		Ссылка = Справочники.Номенклатура.ПолучитьСсылку(УИД);
		Если ЗначениеЗаполнено(Ссылка.Наименование) Тогда
			Возврат Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Справочники.Номенклатура.ПустаяСсылка();
	
КонецФункции
Функция НайтиИлиСоздатьКонтрагента(Имя, Телефон, Email, ИНН)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	НЕ Контрагенты.ПометкаУдаления
	|	И ((&ИНН <> """" И Контрагенты.ИНН = &ИНН)
	|		ИЛИ (&Email <> """" И Контрагенты.Email = &Email)
	|		ИЛИ (&Телефон <> """" И Контрагенты.Телефон = &Телефон))";
	
	Запрос.УстановитьПараметр("ИНН", СокрЛП(ИНН));
	Запрос.УстановитьПараметр("Email", СокрЛП(Email));
	Запрос.УстановитьПараметр("Телефон", СокрЛП(Телефон));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
	НовыйКонтрагент.Наименование = ?(ЗначениеЗаполнено(Имя), Имя, "Покупатель сайта");
	НовыйКонтрагент.ИНН = СокрЛП(ИНН);
	НовыйКонтрагент.Телефон = СокрЛП(Телефон);
	НовыйКонтрагент.Email = СокрЛП(Email);
	НовыйКонтрагент.Записать();
	
	Возврат НовыйКонтрагент.Ссылка;
	
КонецФункции


Процедура ЗаписатьЛогОбмена(СеансОбмена, НаправлениеОбмена, КоличествоОбъектов, КоличествоОшибок, ТекстОшибки = "", ЗаказКлиента = Неопределено)
	
	МенеджерЗаписи = РегистрыСведений.ЛогиОбмена.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = ТекущаяДатаСеанса();
	МенеджерЗаписи.СеансОбмена = СеансОбмена;
	МенеджерЗаписи.НаправлениеОбмена = НаправлениеОбмена;
	МенеджерЗаписи.КоличествоОбъектов = КоличествоОбъектов;
	МенеджерЗаписи.КоличествоОшибок = КоличествоОшибок;
	МенеджерЗаписи.ТекстОшибки = ТекстОшибки;
	
	Если ЗначениеЗаполнено(ЗаказКлиента) Тогда
		МенеджерЗаписи.ЗаказКлиента = ЗаказКлиента;
	КонецЕсли;
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры
Процедура ЗаписатьТег(ЗаписьXML, Имя, Значение)
	ЗаписьXML.ЗаписатьНачалоЭлемента(Имя);
	ЗаписьXML.ЗаписатьТекст(Строка(Значение));
	ЗаписьXML.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура ОтправитьФайлВБитрикс(НТТПСоединение, Заголовки, ТипОбмена, ИмяФайла, ТекстXML, ЗапускатьИмпорт = Истина)
	База = "/bitrix/admin/1c_exchange.php?type=" + ТипОбмена;
	Запрос = Новый HTTPЗапрос(База + "&mode=file&filename=" + ИмяФайла, Заголовки);
	Запрос.УстановитьТелоИзСтроки(ТекстXML, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Ответ = НТТПСоединение.ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 200 Или СтрНайти(Ответ.ПолучитьТелоКакСтроку(), "success") <> 1 Тогда
		ВызватьИсключение("Ошибка отправки " + ИмяФайла);
	КонецЕсли;

	Если ЗапускатьИмпорт Тогда
		ТекстОтвета = "progress";
				Пока СтрНайти(ТекстОтвета, "progress") > 0 Цикл
			Ответ = НТТПСоединение.Получить(Новый HTTPЗапрос(База + "&mode=import&filename=" + ИмяФайла, Заголовки));
			ТекстОтвета = СокрЛП(Ответ.ПолучитьТелоКакСтроку());
			Если Ответ.КодСостояния <> 200 Или (СтрНайти(ТекстОтвета, "success") = 0 И СтрНайти(ТекстОтвета, "progress") = 0) Тогда
				ВызватьИсключение("Ошибка импорта " + ИмяФайла + ": " + ТекстОтвета);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция СформироватьXMLПредложений()
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку("UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("КоммерческаяИнформация");
	ЗаписьXML.ЗаписатьАтрибут("ВерсияСхемы", "2.05");
	ЗаписьXML.ЗаписатьНачалоЭлемента("ПакетПредложений");
			ЗаписьXML.ЗаписатьНачалоЭлемента("ТипыЦен");
	
		ЗаписьXML.ЗаписатьНачалоЭлемента("ТипЦены");
	ЗаписатьТег(ЗаписьXML, "Ид", "BASE");
	ЗаписатьТег(ЗаписьXML, "Наименование", "Розничная");
	ЗаписатьТег(ЗаписьXML, "Валюта", "RUB");
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();

	ЗаписьXML.ЗаписатьНачалоЭлемента("Предложения");

	 
	Запрос = Новый Запрос(
	"ВЫБРАТЬ Тов.Ссылка КАК Товар, Тов.Наименование КАК Наименование,
	|	ЕСТЬNULL(Цены.Цена, 0) КАК Цена, ЕСТЬNULL(Ост.Остаток, 0) КАК Количество
	|ИЗ Справочник.Номенклатура КАК Тов
	|ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ Номенклатура, МАКСИМУМ(Цена) КАК Цена
	|	ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних СГРУППИРОВАТЬ ПО Номенклатура) КАК Цены
	|	ПО Тов.Ссылка = Цены.Номенклатура
	|ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ Номенклатура, СУММА(КоличествоОстаток - РезервОстаток) КАК Остаток
	|	ИЗ РегистрНакопления.ОстаткиТоваров.Остатки СГРУППИРОВАТЬ ПО Номенклатура) КАК Ост
	|	ПО Тов.Ссылка = Ост.Номенклатура
	|ГДЕ НЕ Тов.ПометкаУдаления И НЕ Тов.ЭтоГруппа");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("Предложение");
		ЗаписатьТег(ЗаписьXML, "Ид", Выборка.Товар.УникальныйИдентификатор());
		ЗаписатьТег(ЗаписьXML, "Наименование", СокрЛП(Выборка.Наименование));
		ЗаписьXML.ЗаписатьНачалоЭлемента("Цены");
		ЗаписьXML.ЗаписатьНачалоЭлемента("Цена");
		 ЗаписатьТег(ЗаписьXML, "ИдТипаЦены", "BASE");

		ЗаписатьТег(ЗаписьXML, "ЦенаЗаЕдиницу", Формат(Выборка.Цена, "ЧРД=.; ЧГ=0"));
		ЗаписатьТег(ЗаписьXML, "Валюта", "RUB");
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписатьТег(ЗаписьXML, "Количество", Формат(Макс(Выборка.Количество, 0), "ЧРД=.; ЧГ=0"));
		ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЦикла;

	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	Возврат ЗаписьXML.Закрыть();
