Процедура ВыполнитьРегламентныйОбмен() Экспорт
	НастройкиОбмена = ПолучитьНастройкиИнтеграции();
	ВыгрузитьИзмененияНаСайт(НастройкиОбмена);
	ЗагрузитьЗаказыССайта(НастройкиОбмена);
	
КонецПроцедуры

Функция ПолучитьНастройкиИнтеграции()
	Настройки = Новый Структура("АдресСайта, Логин, Пароль", "", "", "");
	
	Выборка = РегистрыСведений.НастройкиИнтеграции.Выбрать();
	Если Выборка.Следующий() Тогда
		Настройки.АдресСайта = Выборка.АдресСайта;
		Настройки.Логин = Выборка.Логин;
		Если Выборка.ПарольУстановлен Тогда
			Настройки.Пароль = ХранилищеОбщихНастроек.Получить("ПарольИнтеграцииССайтом");
			КонецЕсли;
	КонецЕсли;
	
	Возврат Настройки;
КонецФункции

Процедура ВыгрузитьИзмененияНаСайт(НастройкиОбмена)
	// Тут мы подключим План обмена, чтобы не гнать всю базу каждый раз
КонецПроцедуры

  Процедура ЗагрузитьЗаказыССайта(НастройкиОбмена) Экспорт
	
	ИдентификаторСеанса = Строка(Новый УникальныйИдентификатор());
	
	Попытка
		HTTPСоединение = Новый HTTPСоединение(НастройкиОбмена.АдресСайта, , 
			НастройкиОбмена.Логин, НастройкиОбмена.Пароль, , , Новый ЗащищенноеСоединениеOpenSSL());
		
		ЗапросHTTP = Новый HTTPЗапрос("/bitrix/admin/1c_exchange.php?type=sale&mode=query");
		ОтветHTTP = HTTPСоединение.Получить(ЗапросHTTP);
	Исключение
		ТекстОшибки = "Сайт вернул ошибку соединения. Проверьте сеть.";
		ЗаписьЖурналаРегистрации("Обмен с сайтом. Ошибка", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		ЗаписатьЛогОбмена(ИдентификаторСеанса, "Загрузка с сайта", 0, 1, ТекстОшибки);
		Возврат;  
	КонецПопытки;
	
	Если ОтветHTTP.КодСостояния <> 200 Тогда
		ТекстОшибки = "Сайт вернул ошибку соединения. Код состояния: " + ОтветHTTP.КодСостояния;
		ЗаписьЖурналаРегистрации("Обмен с сайтом. Ошибка", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		ЗаписатьЛогОбмена(ИдентификаторСеанса, "Загрузка с сайта", 0, 1, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ТекстXML = ОтветHTTP.ПолучитьТелоКакСтроку();
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстXML);
	
	ТаблицаЗаказов = Новый ТаблицаЗначений;
	ТаблицаЗаказов.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	ТаблицаЗаказов.Колонки.Добавить("Товары", Новый ОписаниеТипов("ТаблицаЗначений")); 	
	
	ТекущийЗаказНомер = "";
	ВременнаяТЧТоваров = Неопределено;
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ИмяТега = ЧтениеXML.Имя;
			
			Если ИмяТега = "Документ" Тогда
				ТекущийЗаказНомер = "";
				ВременнаяТЧТоваров = Новый ТаблицаЗначений;
				ВременнаяТЧТоваров.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
				ВременнаяТЧТоваров.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
				ВременнаяТЧТоваров.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
				
			ИначеЕсли ИмяТега = "Ид" И ВременнаяТЧТоваров <> Неопределено Тогда
				ЧтениеXML.Прочитать();
				ТекущийЗаказНомер = СокрЛП(ЧтениеXML.Значение);
			ИначеЕсли ИмяТега = "Товар" Тогда
				СтрокаТовара = ВременнаяТЧТоваров.Добавить();
				Пока ЧтениеXML.Прочитать() Цикл
					Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
						ПодТег = ЧтениеXML.Имя;
						Если ПодТег = "Наименование" Тогда
							ЧтениеXML.Прочитать();
							СтрокаТовара.Наименование = СокрЛП(ЧтениеXML.Значение);
						ИначеЕсли ПодТег = "Количество" Тогда
							ЧтениеXML.Прочитать();
							СтрокаТовара.Количество = Число(ЧтениеXML.Значение);
						ИначеЕсли ПодТег = "ЦенаЗаЕдиницу" Тогда
							ЧтениеXML.Прочитать();
							СтрокаТовара.Цена = Число(ЧтениеXML.Значение);
						КонецЕсли;
					ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ЧтениеXML.Имя = "Товар" Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ЧтениеXML.Имя = "Документ" Тогда
			НовыйЗаказСтрока = ТаблицаЗаказов.Добавить();
			НовыйЗаказСтрока.Номер = ТекущийЗаказНомер;
			НовыйЗаказСтрока.Товары = ВременнаяТЧТоваров;
			ВременнаяТЧТоваров = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	ЧтениеXML.Закрыть(); 
	
	ОсновнойСклад = Справочники.Склады.НайтиПоНаименованию("Основной");
	КоличествоУспешныхДокументов = 0;
	КоличествоОшибокВОбмене = 0;	
	НакопленныйТекстОшибок = "";
	ПоследнийСозданныйЗаказ = Документы.ЗаказКлиента.ПустаяСсылка();
	
	Для Каждого СтрокаЗаказа Из ТаблицаЗаказов Цикл
		Попытка
			НовыйЗаказ = Документы.ЗаказКлиента.СоздатьДокумент();
			НовыйЗаказ.Дата = ТекущаяДатаСеанса();
			НовыйЗаказ.Номер = СтрокаЗаказа.Номер;
			НовыйЗаказ.Склад = ОсновнойСклад;
			НовыйЗаказ.СтатусЗаказа = Перечисления.СтатусыЗаказов.Новый;
			
			Для Каждого ТоварИзПамяти Из СтрокаЗаказа.Товары Цикл
				НайденнаяНоменклатура = Справочники.Номенклатура.НайтиПоНаименованию(ТоварИзПамяти.Наименование);
				Если НайденнаяНоменклатура.Пустая() Тогда
					ВызватьИсключение("Товар не найден в справочнике Номенклатура: " + ТоварИзПамяти.Наименование);
				КонецЕсли;
				
				НоваяСтрокаТЧ = НовыйЗаказ.Товары.Добавить();
				НоваяСтрокаТЧ.Номенклатура = НайденнаяНоменклатура;
				НоваяСтрокаТЧ.Количество = ТоварИзПамяти.Количество;
				НоваяСтрокаТЧ.Цена = ТоварИзПамяти.Цена;
				НоваяСтрокаТЧ.Сумма = ТоварИзПамяти.Количество * ТоварИзПамяти.Цена;
			КонецЦикла;
			
			НовыйЗаказ.Записать(РежимЗаписиДокумента.Запись);
			ПоследнийСозданныйЗаказ = НовыйЗаказ.Ссылка;
			КоличествоУспешныхДокументов = КоличествоУспешныхДокументов + 1;
		Исключение
			КоличествоОшибокВОбмене = КоличествоОшибокВОбмене + 1;
			ОписаниеОшибкиСтрокой = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			НакопленныйТекстОшибок = НакопленныйТекстОшибок + ОписаниеОшибкиСтрокой + Символы.ПС;
			ЗаписьЖурналаРегистрации("Обмен с сайтом. Ошибка создания документа", УровеньЖурналаРегистрации.Ошибка, , , 
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации("Обмен с сайтом. Итоги", УровеньЖурналаРегистрации.Информация, , , 
		"Обмен завершен. Создано заказов: " + КоличествоУспешныхДокументов + ". Ошибок: " + КоличествоОшибокВОбмене);
	
	ЗаписатьЛогОбмена(
		ИдентификаторСеанса,
		"Загрузка с сайта",
		КоличествоУспешныхДокументов,
		КоличествоОшибокВОбмене,
		СокрЛП(НакопленныйТекстОшибок),
		ПоследнийСозданныйЗаказ
	);
	
КонецПроцедуры

Процедура ЗаписатьЛогОбмена(СеансОбмена, НаправлениеОбмена, КоличествоОбъектов, КоличествоОшибок, ТекстОшибки = "", ЗаказКлиента = Неопределено)
	
	МенеджерЗаписи = РегистрыСведений.ЛогиОбмена.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = ТекущаяДатаСеанса();
	МенеджерЗаписи.СеансОбмена = СеансОбмена;
	МенеджерЗаписи.НаправлениеОбмена = НаправлениеОбмена;
	МенеджерЗаписи.КоличествоОбъектов = КоличествоОбъектов;
	МенеджерЗаписи.КоличествоОшибок = КоличествоОшибок;
	МенеджерЗаписи.ТекстОшибки = ТекстОшибки;
	
	Если ЗначениеЗаполнено(ЗаказКлиента) Тогда
		МенеджерЗаписи.ЗаказКлиента = ЗаказКлиента;
	КонецЕсли;
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры