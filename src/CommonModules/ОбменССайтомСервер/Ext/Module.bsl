Функция ПодключитьсяКБитрикс(НастройкиОбмена, ТипОбмена)
	АдресСайта = СокрЛП(НастройкиОбмена.АдресСайта);
	ИспользоватьSSL = (СтрНайти(НРег(АдресСайта), "https://") = 1);
	БезПротокола = СтрЗаменить(СтрЗаменить(АдресСайта, "https://", ""), "http://", "");
	Сервер = СтрРазделить(БезПротокола, "/")[0];
	Порт = ?(ИспользоватьSSL, 443, 80);

	Части = СтрРазделить(Сервер, ":");
	Сервер = Части[0];
	Если Части.Количество() > 1 Тогда
		Порт = Число(Части[1]);
	КонецЕсли;

	SSL = ?(ИспользоватьSSL, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено);
	Соединение = Новый HTTPСоединение(Сервер, Порт, НастройкиОбмена.Логин, НастройкиОбмена.Пароль, , 60, SSL);

	База = "/bitrix/admin/1c_exchange.php?type=" + ТипОбмена;
	Ответ = Соединение.Получить(Новый HTTPЗапрос(База + "&mode=checkauth"));
	Строки = СтрРазделить(Ответ.ПолучитьТелоКакСтроку(), Символы.ПС);

	Если Ответ.КодСостояния <> 200 Или Строки.Количество() < 3 Или СокрЛП(Строки[0]) <> "success" Тогда
		ВызватьИсключение("Ошибка авторизации (" + ТипОбмена + ")");
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Cookie", СокрЛП(Строки[1]) + "=" + СокрЛП(Строки[2]));

	ОтветИнит = Соединение.Получить(Новый HTTPЗапрос(База + "&mode=init", Заголовки));
	Если ОтветИнит.КодСостояния <> 200 Тогда
		ВызватьИсключение("Ошибка инициализации (" + ТипОбмена + ")");
	КонецЕсли;

	Возврат Новый Структура("Соединение, Заголовки", Соединение, Заголовки);
КонецФункции

