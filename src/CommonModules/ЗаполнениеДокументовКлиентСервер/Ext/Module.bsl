Процедура ЗаполнитьДокументНаОсновании(ОбъектДокумента, ДанныеЗаполнения) Экспорт
	
			СсылкаНаОснование = Неопределено;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
			ДанныеЗаполнения.Свойство("Основание", СсылкаНаОснование);
	Если Не ЗначениеЗаполнено(СсылкаНаОснование) Тогда
			ДанныеЗаполнения.Свойство("ЗаказКлиента", СсылкаНаОснование);
	КонецЕсли;
	Иначе
			СсылкаНаОснование = ДанныеЗаполнения;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СсылкаНаОснование) Тогда
	Возврат;
	КонецЕсли;
	

			ЗаполнитьЗначенияСвойств(ОбъектДокумента, СсылкаНаОснование, , "Товары");
	
	Попытка
			ОбъектДокумента.ДокументОснование = СсылкаНаОснование;
	Исключение
	КонецПопытки;
	
			ОбъектДокумента.Товары.Загрузить(СсылкаНаОснование.Товары.Выгрузить());

		КонецПроцедуры
		
		
