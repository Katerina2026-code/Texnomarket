       &НаСервере
Процедура ЗаполнитьТестовымиДаннымиНаСервере()
	
	// 1. Создаём Склад ("Основной"), если его ещё нет
	Склад = Справочники.Склады.НайтиПоНаименованию("Основной");
	Если Не ЗначениеЗаполнено(Склад) Тогда
		СкладОбъект = Справочники.Склады.СоздатьЭлемент();
		СкладОбъект.Наименование = "Основной";
		СкладОбъект.Записать();
		Склад = СкладОбъект.Ссылка;
	КонецЕсли;
	
	// 2. Создаём Вид цены ("Розничная"), если его ещё нет
	ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию("Розничная");
	Если Не ЗначениеЗаполнено(ВидЦены) Тогда
		ВидЦеныОбъект = Справочники.ВидыЦен.СоздатьЭлемент();
		ВидЦеныОбъект.Наименование = "Розничная";
		ВидЦеныОбъект.Записать();
		ВидЦены = ВидЦеныОбъект.Ссылка;
	КонецЕсли;
	
	// 3. Создаём Контрагентов (Поставщика и Покупателя)
	Поставщик = Справочники.Контрагенты.НайтиПоНаименованию("ООО Поставщик Техники");
	Если Не ЗначениеЗаполнено(Поставщик) Тогда
		ПоставщикОбъект = Справочники.Контрагенты.СоздатьЭлемент();
		ПоставщикОбъект.Наименование = "ООО Поставщик Техники";
		ПоставщикОбъект.Записать();
		Поставщик = ПоставщикОбъект.Ссылка;
	КонецЕсли;
	
	Покупатель = Справочники.Контрагенты.НайтиПоНаименованию("Иванов Иван Иванович");
	Если Не ЗначениеЗаполнено(Покупатель) Тогда
		ПокупательОбъект = Справочники.Контрагенты.СоздатьЭлемент();
		ПокупательОбъект.Наименование = "Иванов Иван Иванович";
		ПокупательОбъект.Записать();
	КонецЕсли;
	
	// 4. Создаём 3 товара и формируем списки для документов
	СписокТоваров = Новый Массив;
	СписокТоваров.Добавить(Новый Структура("Наименование, ЦенаЗакупки, ЦенаПродажи, Количество", "Смартфон Apple iPhone 15", 75000, 98000, 10));
	СписокТоваров.Добавить(Новый Структура("Наименование, ЦенаЗакупки, ЦенаПродажи, Количество", "Телевизор Samsung 55 UHD", 48000, 65000, 12));
	СписокТоваров.Добавить(Новый Структура("Наименование, ЦенаЗакупки, ЦенаПродажи, Количество", "Электрический чайник Bosch", 2800, 4500, 10));
	
	// 5. Создаём и проводим документ "УстановкаЦен"
	ДокУстановкаЦен = Документы.УстановкаЦен.СоздатьДокумент();
	ДокУстановкаЦен.Дата = ТекущаяДата();
	ДокУстановкаЦен.ВидыЦен = ВидЦены;
	
	// 6. Создаём и проводим документ "ПоступлениеТоваров"
	ДокПоступление = Документы.ПоступлениеТоваров.СоздатьДокумент();
	ДокПоступление.Дата = ТекущаяДата();
	ДокПоступление.Поставщик = Поставщик;
	ДокПоступление.Склад = Склад;
	
	Для Каждого Элемент Из СписокТоваров Цикл
		Товар = Справочники.Номенклатура.НайтиПоНаименованию(Элемент.Наименование);
		Если Не ЗначениеЗаполнено(Товар) Тогда
			ТоварОбъект = Справочники.Номенклатура.СоздатьЭлемент();
			ТоварОбъект.Наименование = Элемент.Наименование;
			ТоварОбъект.Записать();
			Товар = ТоварОбъект.Ссылка;
		КонецЕсли;
		
		// Строка в Установку цен
		СтрокаЦен = ДокУстановкаЦен.Товары.Добавить();
		СтрокаЦен.Номенклатура = Товар;
		СтрокаЦен.Цена = Элемент.ЦенаПродажи;
		
		// Строка в Поступление товаров
		СтрокаПоступления = ДокПоступление.Товары.Добавить();
		СтрокаПоступления.Номенклатура = Товар;
		СтрокаПоступления.Количество = Элемент.Количество;
		СтрокаПоступления.Цена = Элемент.ЦенаЗакупки;
		СтрокаПоступления.Сумма = Элемент.Количество * Элемент.ЦенаЗакупки;
	КонецЦикла;
	
	ДокУстановкаЦен.Записать(РежимЗаписиДокумента.Проведение);
	ДокПоступление.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТестовымиДанными(Команда)
	ЗаполнитьТестовымиДаннымиНаСервере();
	ПоказатьОповещениеПользователя("Готово!", , "Тестовые справочники, цены и поступление товаров успешно созданы и проведены.");
КонецПроцедуры
