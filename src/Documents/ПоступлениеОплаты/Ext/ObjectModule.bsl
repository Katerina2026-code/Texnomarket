Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если ЗначениеЗаполнено(ЗаказКлиента) Тогда 
		Движения.Взаиморасчеты.Записывать = Истина;
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Документ.ЗаказКлиента");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ЗаказКлиента);
		Блокировка.Заблокировать();;
		ОбъектЗаказа = ЗаказКлиента.ПолучитьОбъект();
		ОбъектЗаказа.СтатусЗаказа = Перечисления.СтатусыЗаказов.Оплачен;
		ОбъектЗаказа.Записать(РежимЗаписиДокумента.Запись);
		Движение = Движения.Взаиморасчеты.ДобавитьРасход();
		Движение.Период = Дата;
		Движение.Контрагент = Контрагент;
		Движение.Сумма = Сумма;
	КонецЕсли;
КонецПроцедуры 



Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		
		ЗаказКлиента = ДанныеЗаполнения; 
		Контрагент   = ДанныеЗаполнения.Контрагент;
		
		ИтоговыеДеньги = 0;
		Для Каждого СтрокаТовара Из ДанныеЗаполнения.Товары Цикл
			ИтоговыеДеньги = ИтоговыеДеньги + (СтрокаТовара.Количество * СтрокаТовара.Цена);
		КонецЦикла;
	
		Сумма = ИтоговыеДеньги;
	   	КонецЕсли;
КонецПроцедуры