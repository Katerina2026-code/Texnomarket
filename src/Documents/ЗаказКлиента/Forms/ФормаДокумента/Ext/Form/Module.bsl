&НаКлиенте
Процедура СпособДоставкиПриИзменении(Элемент)
	
	
	Если ЗначениеЗаполнено(Объект.СпособДоставки) Тогда
		Объект.КодНаСайте = ПолучитьКодДоставкиНаСервере(Объект.СпособДоставки);
	Иначе
		Объект.КодНаСайте = "";
	КонецЕсли;
	
	ЭтаФорма.ОбновитьОтображениеДанных();
КонецПроцедуры
&НаСервере
Функция ПолучитьКодДоставкиНаСервере(Знач СсылкаНаСпособ)
	
	Если Не ЗначениеЗаполнено(СсылкаНаСпособ) Тогда
		Возврат "";
	КонецЕсли;
	
		Возврат СсылкаНаСпособ.КодНаСайте; 
	
КонецФункции
&НаКлиенте
Процедура КодНаСайтеПриИзменении(Элемент)
	
		НайтиСпособДоставкиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура НайтиСпособДоставкиНаСервере()
	
		Если Объект.КодНаСайте = "3" Тогда
		НайденноеЗначение = Справочники.СпособыДоставкиИОплаты.НайтиПоНаименованию("Курьер");
	ИначеЕсли Объект.КодНаСайте = "1" Тогда
		НайденноеЗначение = Справочники.СпособыДоставкиИОплаты.НайтиПоНаименованию("Самовывоз");
	Иначе
		НайденноеЗначение = Справочники.СпособыДоставкиИОплаты.ПустаяСсылка();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденноеЗначение) Тогда
		Объект.СпособДоставки = НайденноеЗначение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	СтрокаТаблицы.Цена = ПолучитьРозничнуюЦенуНаСервере(СтрокаТаблицы.Номенклатура, Объект.Дата);
	СтрокаТаблицы.Сумма = СтрокаТаблицы.Количество * СтрокаТаблицы.Цена;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРозничнуюЦенуНаСервере(Знач СсылкаНаТовар, Знач ДатаДокумента)
	
	Если Не ЗначениеЗаполнено(СсылкаНаТовар) Тогда
		Возврат 0;   
	КонецЕсли;
	
	ВидЦеныРозничная = Справочники.ВидыЦен.НайтиПоНаименованию("Розничная");
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Номенклатура", СсылкаНаТовар);
	СтруктураОтбора.Вставить("ВидЦены", ВидЦеныРозничная);
	
	ТЗЦен = РегистрыСведений.ЦеныНоменклатуры.СрезПоследних(ДатаДокумента, СтруктураОтбора); 
	Если ТЗЦен.Количество() > 0 Тогда
		Возврат ТЗЦен[0].Цена;
	Иначе
		Возврат 0;
	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	СтрокаТаблицы.Сумма = СтрокаТаблицы.Количество * СтрокаТаблицы.Цена;
КонецПроцедуры


		