
Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.Продажи.Записывать = Истина; 
	Движения.Взаиморасчеты.Записывать = Истина;
	Движения.ОстаткиТоваров.БлокироватьДляИзменения = Истина; 
	ЗапросЦен = Новый Запрос;
	ЗапросЦен.Текст =
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&МоментВремени,
	|			Номенклатура В (&Список)
	|		И ВидЦены = &ВидЦен)КАК ЦеныНоменклатурыСрезПоследних"; 
	ЗапросЦен.УстановитьПараметр("МоментВремени", МоментВремени());
	ЗапросЦен.УстановитьПараметр("Список", Товары.ВыгрузитьКолонку("Номенклатура"));
	ЗапросЦен.УстановитьПараметр("ВидЦен", Константы.Закупочная.Получить());
	ТаблицаЦен = ЗапросЦен.Выполнить().Выгрузить();
	ТаблицаЦен.Индексы.Добавить("Номенклатура");
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;
		Движение.Склад = Склад;
		Движение.Количество = ТекСтрокаТовары.Количество;
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
			Движение.ЗаказКлиента = ДокументОснование;
			Движение.Резерв = ТекСтрокаТовары.Количество;
		КонецЕсли;
		ДвижениеПр = Движения.Продажи.Добавить();
		ДвижениеПр.Период = Дата;
		ДвижениеПр.Контрагент = Контрагент; 
		ДвижениеПр.Номенклатура = ТекСтрокаТовары.Номенклатура;
		ДвижениеПр.Характеристика = ТекСтрокаТовары.Характеристика;
		ДвижениеПр.Количество   = ТекСтрокаТовары.Количество;
		ДвижениеПр.Сумма = ТекСтрокаТовары.Сумма;
		СтрокаЦены = ТаблицаЦен.Найти(ТекСтрокаТовары.Номенклатура, "Номенклатура");
		ДвижениеПр.Себестоимость = ?(СтрокаЦены <> Неопределено, СтрокаЦены.Цена, 0) * ТекСтрокаТовары.Количество;
	КонецЦикла;
	Движения.ОстаткиТоваров.Записать(); 
	ЗапросМинусов = Новый Запрос;
	ЗапросМинусов.Текст = "ВЫБРАТЬ
	|	ОстаткиТоваровОстатки.Номенклатура КАК Номенклатура,
	|	ОстаткиТоваровОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ОстаткиТоваровОстатки.РезервОстаток - ОстаткиТоваровОстатки.КоличествоОстаток КАК НехваткаПодРезерв
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(&МоментВремени, Склад = &Склад) КАК ОстаткиТоваровОстатки
	|ГДЕ
	|	ОстаткиТоваровОстатки.КоличествоОстаток < 0
	|	ИЛИ ОстаткиТоваровОстатки.КоличествоОстаток - ОстаткиТоваровОстатки.РезервОстаток < 0"; 
	ГраницаКонтроля = Новый Граница(МоментВремени(), ВидГраницы.Включая);
	ЗапросМинусов.УстановитьПараметр("МоментВремени", ГраницаКонтроля);
	ЗапросМинусов.УстановитьПараметр("Склад", Склад);
	РезультатПроверки = ЗапросМинусов.Выполнить();
	Если Не РезультатПроверки.Пустой() Тогда 
		ВыборкаОшибок = РезультатПроверки.Выбрать();
		Пока ВыборкаОшибок.Следующий() Цикл
			Сообщение = Новый СообщениеПользователю;
			Если ВыборкаОшибок.КоличествоОстаток < 0 Тогда
				Сообщение.Текст = "Не хватает товара: " + ВыборкаОшибок.Номенклатура + " в количестве: " + (-ВыборкаОшибок.КоличествоОстаток) + " шт.";
			Иначе
				Сообщение.Текст = "Не хватает свободного товара (чужой резерв): " + ВыборкаОшибок.Номенклатура + " в количестве: " + ВыборкаОшибок.НехваткаПодРезерв + " шт.";
			КонецЕсли;
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЦикла; 
	КонецЕсли;
	Если Не Отказ Тогда
		ДвижениеВз = Движения.Взаиморасчеты.Добавить();
		ДвижениеВз.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеВз.Период = Дата;
		ДвижениеВз.Контрагент = Контрагент;
		ДвижениеВз.Сумма = Товары.Итог("Сумма");
	КонецЕсли;
	
КонецПроцедуры


Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	
	
	ЗаполнениеДокументовСервер.ЗаполнитьДокументНаОсновании(ЭтотОбъект, ДанныеЗаполнения);		
	
КонецПроцедуры		



